#include <iostream>
#include <vector>
using namespace std;
int networkDelayTime(vector<vector<int>>& times, int n, int k) {
    vector<vector<pair<int,int>>> graph(n + 1);
    for(int i = 0; i < times.size(); i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        graph[u].push_back({v, w});
    }
    vector<int> dist(n + 1, 1000000000);
    vector<bool> visited(n + 1, false);
    dist[k] = 0;
    for(int i = 1; i <= n; i++) {
        int u = -1;
        for(int j = 1; j <= n; j++) {
            if(!visited[j] && (u == -1 || dist[j] < dist[u])) {
                u = j;
            }
        }
        if(u == -1 || dist[u] == 1000000000) {
            break;
        }
        visited[u] = true;
        for(int j = 0; j < graph[u].size(); j++) {
            int v = graph[u][j].first;
            int w = graph[u][j].second;
            if(dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
            }
        }
    }
    int answer = 0;
    for(int i = 1; i <= n; i++) {
        if(dist[i] == 1000000000) {
            return -1;
        }
        if(dist[i] > answer) {
            answer = dist[i];
        }
    }
    return answer;
}
int main() {
    int m;
    cin >> m;
    vector<vector<int>> times(m, vector<int>(3));
    for(int i = 0; i < m; i++) {
        cin >> times[i][0] >> times[i][1] >> times[i][2];
    }
    int n, k;
    cin >> n >> k;
    cout << networkDelayTime(times, n, k) << endl;
    return 0;
}
