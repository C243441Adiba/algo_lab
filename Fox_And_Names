#include <iostream>
#include <vector>
#include <queue>
#include <string>
using namespace std;
int main() {
    int n;
    cin >> n;
    vector<string> names(n);
    for(int i = 0; i < n; i++) {
        cin >> names[i];
    }
    vector<vector<int>> graph(26);
    vector<int> indegree(26, 0);
    for(int i = 0; i < n - 1; i++) {
        string a = names[i];
        string b = names[i + 1];
        int len = min(a.size(), b.size());
        bool found = false;
        for(int j = 0; j < len; j++) {
            if(a[j] != b[j]) {
                int u = a[j] - 'a';
                int v = b[j] - 'a';
                bool exists = false;
                for(int k = 0; k < graph[u].size(); k++) {
                    if(graph[u][k] == v) {
                        exists = true;
                        break;
                    }
                }
                if(!exists) {
                    graph[u].push_back(v);
                    indegree[v]++;
                }
                found = true;
                break;
            }
        }
        if(!found && a.size() > b.size()) {
            cout << "Impossible" << endl;
            return 0;
        }
    }
    queue<int> q;
    for(int i = 0; i < 26; i++) {
        if(indegree[i] == 0) {
            q.push(i);
        }
    }
    string answer = "";
    while(!q.empty()) {
        int u = q.front();
        q.pop();
        answer += char(u + 'a');
        for(int i = 0; i < graph[u].size(); i++) {
            int v = graph[u][i];
            indegree[v]--;
            if(indegree[v] == 0) {
                q.push(v);
            }
        }
    }
    if(answer.size() != 26) {
        cout << "Impossible" << endl;
        return 0;
    }
    cout << answer << endl;
    return 0;
}
