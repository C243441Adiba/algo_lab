#include <iostream>
#include <vector>
using namespace std;
vector<int> shortestReach(int n, vector<vector<int>> edges, int s) {
    vector<vector<pair<int,int>>> graph(n + 1);
    for(int i = 0; i < edges.size(); i++) {
        int u = edges[i][0];
        int v = edges[i][1];
        int w = edges[i][2];
        graph[u].push_back({v, w});
        graph[v].push_back({u, w});
    }
    vector<int> dist(n + 1, 1000000000);
    vector<bool> visited(n + 1, false);
    dist[s] = 0;
    for(int i = 1; i <= n; i++) {
        int u = -1;
        for(int j = 1; j <= n; j++) {
            if(!visited[j] &&
               (u == -1 || dist[j] < dist[u])) {
                u = j;
            }
        }
        if(u == -1 || dist[u] == 1000000000) {
            break;
        }
        visited[u] = true;
        for(int j = 0; j < graph[u].size(); j++) {
            int v = graph[u][j].first;
            int w = graph[u][j].second;
            if(dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
            }
        }
    }
    vector<int> answer;
    for(int i = 1; i <= n; i++) {
        if(i == s) {
            continue;
        }
        if(dist[i] == 1000000000) {
            answer.push_back(-1);
        }
        else {
            answer.push_back(dist[i]);
        }
    }
    return answer;
}
int main() {
    int t;
    cin >> t;
    while(t--) {
        int n, m;
        cin >> n >> m;
        vector<vector<int>> edges(m, vector<int>(3));
        for(int i = 0; i < m; i++) {
            cin >> edges[i][0]
                >> edges[i][1]
                >> edges[i][2];
        }
        int s;
        cin >> s;
        vector<int> result = shortestReach(n, edges, s);
        for(int i = 0; i < result.size(); i++) {
            cout << result[i];
            if(i + 1 < result.size()) {
                cout << " ";
            }
        }
        cout << endl;
    }
    return 0;
}
