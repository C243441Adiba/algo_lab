#include <iostream>
#include <vector>
#include <string>

using namespace std;

vector<string> ans;

void backtrack(string &s, int index)
{
    if(index == s.size())
    {
        ans.push_back(s);
        return;
    }

    if(s[index] >= '0' && s[index] <= '9')
    {
        backtrack(s, index + 1);
    }
    else
    {
        char original = s[index];

        if(s[index] >= 'A' && s[index] <= 'Z')
            s[index] = s[index] + 32;

        backtrack(s, index + 1);

        s[index] = original;

        if(s[index] >= 'a' && s[index] <= 'z')
            s[index] = s[index] - 32;

        backtrack(s, index + 1);

        s[index] = original;
    }
}

int main()
{
    string s;
    cin >> s;

    backtrack(s, 0);

    cout << "[";

    for(int i = 0; i < ans.size(); i++)
    {
        cout << "\"" << ans[i] << "\"";

        if(i != ans.size() - 1)
            cout << ",";
    }

    cout << "]";

    return 0;
}
