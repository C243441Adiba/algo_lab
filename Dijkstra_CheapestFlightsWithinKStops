#include <iostream>
#include <vector>
using namespace std;
int findCheapestPrice(int n, vector<vector<int>>& flights,
                      int src, int dst, int k) {
    vector<int> cost(n, 1000000000);
    cost[src] = 0;
    for(int i = 0; i <= k; i++) {
        vector<int> temp = cost;
        for(int j = 0; j < flights.size(); j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int price = flights[j][2];
            if(cost[u] != 1000000000 &&
               cost[u] + price < temp[v]) {
                temp[v] = cost[u] + price;
            }
        }
        cost = temp;
    }
    if(cost[dst] == 1000000000) {
        return -1;
    }
    return cost[dst];
}
int main() {
    int n, m;
    cin >> n >> m;
    vector<vector<int>> flights(m, vector<int>(3));
    for(int i = 0; i < m; i++) {
        cin >> flights[i][0]
            >> flights[i][1]
            >> flights[i][2];
    }
    int src, dst, k;
    cin >> src >> dst >> k;
    cout << findCheapestPrice(n, flights, src, dst, k) << endl;
    return 0;
}
