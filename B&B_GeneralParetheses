#include <iostream>
#include <vector>
#include <string>

using namespace std;

vector<string> ans;

void backtrack(string current, int open, int close, int n)
{
    if(current.size() == 2 * n)
    {
        ans.push_back(current);
        return;
    }

    if(open < n)
    {
        backtrack(current + "(", open + 1, close, n);
    }

    if(close < open)
    {
        backtrack(current + ")", open, close + 1, n);
    }
}

int main()
{
    int n;
    cin >> n;

    backtrack("", 0, 0, n);

    cout << "[";

    for(int i = 0; i < ans.size(); i++)
    {
        cout << "\"" << ans[i] << "\"";

        if(i != ans.size() - 1)
            cout << ",";
    }

    cout << "]";

    return 0;
}
